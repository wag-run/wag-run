# Settings for docker-compose.yml. Copy to .env and set DB_PASSWORD.

# Required. Password for the bundled PostgreSQL database. Generate with:
#   openssl rand -hex 24
DB_PASSWORD=

# Optional. Encrypts sessions and stored secrets. Left empty, a key is generated
# on first run and kept in the storage volume. To manage it yourself, generate
# one with:  echo "base64:$(openssl rand -base64 32)"
# Never change it on a running install.
APP_KEY=

# The public URL people use to reach wag.run. Webhook and form links use it.
APP_URL=http://localhost:8080

# Where the container listens on the host. Keep 127.0.0.1 when a reverse proxy
# on this host forwards to it; use 0.0.0.0 to expose the port directly.
APP_BIND=127.0.0.1
APP_PORT=8080

# Behind a reverse proxy that terminates TLS: the proxy's IP address or CIDR
# range (comma-separated), or * if the app is reachable only through the proxy.
TRUSTED_PROXIES=
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

# Optional. Email can also be set up in the app under Organization > Email.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

# Optional tuning.
# APP_NAME=wag.run
# LOG_LEVEL=info
# QUEUE_WORKERS=2
# APP_MEMORY_LIMIT=1g
# DB_MEMORY_LIMIT=1g
